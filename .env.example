# =====================================================================
#  SAASSP environment settings
#  This file is read automatically when the app starts (python app.py
#  or flask run). Keep it private - never commit it or share it.
# =====================================================================

# --- Flask security --------------------------------------------------
# Signs login sessions/cookies. A random value has been generated for you.
SECRET_KEY=replace-with-a-long-random-string

# --- Database --------------------------------------------------------
# Leave commented out to use the built-in SQLite file (saassp.db).
# Uncomment and fill in to use MySQL (e.g. XAMPP):
# DATABASE_URL=mysql+pymysql://saassp_user:your_mysql_password@localhost/saassp_app

# --- AI feedback (Gemini) --------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# Leave empty and the app still works, just without AI feedback text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Server ----------------------------------------------------------
# 1 = debug mode on (auto-reload, error pages). Set to 0 for a demo/deploy.
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
